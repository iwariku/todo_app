%h1 タスク詳細

.d-flex.gap-2
  = link_to "タスク編集", edit_task_path(@task), class: "btn btn-primary"
  = button_to "タスクを削除", task_path(@task), method: :delete, data: { turbo_confirm: "本当に削除してもよろしいですか？" }, class: "btn btn-danger"

%table.table
  %tr
    %th タイトル
    %td= @task.title
  %tr
    %th 説明
    %td= @task.description